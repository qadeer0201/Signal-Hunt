# Hosted use: set ADMIN_PASSWORD as a secret in the hosting provider. Never commit it.
ADMIN_PASSWORD=
STRICT_SECURITY=1
SECURE_COOKIES=0

MAX_TEAMS=10

# Level timers are configured separately in the host dashboard (defaults: 15/20/20/25 minutes).
# Teams have 3-5 members/devices, so 10 teams at max 5 each means 50 total devices.
DATABASE_PATH=/data/signalhunt.db
# Optional override; normally detected from the integrated folder structure.
# FRONTEND_DIR=/app/Frontend
